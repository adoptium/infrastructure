# -*- mode: ruby -*-
# vi: set ft=ruby :

$script = <<SCRIPT
sudo apt-get install tree -y
sudo apt-get install software-properties-common
sudo apt-add-repository ppa:ansible/ansible
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" install --only-upgrade grub-pc
sudo apt-get install ansible -y
sudo mkdir /ansible
sudo cp /etc/ansible/ansible.cfg /ansible
sudo touch /ansible/hosts
sudo sed -i 's?#inventory      = /etc/ansible/hosts?inventory = /ansible/hosts?g' /ansible/ansible.cfg
echo "---------------------------------------------------------------------------------------"
echo "*** Creating public-private keypair for ansible-playbook... for user '$USER' *** "
yes y | ssh-keygen -t rsa -b 4096 -C "adoptopenjdk@gmail.com" -q -P "" -f $HOME/.ssh/id_rsa
echo "---------------------------------------------------------------------------------------"
echo "*** Public-private keypair for ansible-playbook... for user '$USER' has been created in *** "
ls -lash $HOME/.ssh
echo "---------------------------------------------------------------------------------------"
export VAGRANT_MOUNT=/vagrant
echo "*** Creating 'hosts' file for ansible-playbook... ***"
echo "localhost ansible_connection=local" > $VAGRANT_MOUNT/playbooks/hosts
echo "---------------------------------------------------------------------------------------"
echo "*** '$VAGRANT_MOUNT/playbooks/hosts' file for ansible-playbook contains ***"
cat $VAGRANT_MOUNT/playbooks/hosts
echo "---------------------------------------------------------------------------------------"
# Put the host machine's IP into the authorised_keys file on the VM
if [ -r /vagrant/id_rsa.pub ]; then
        mkdir -p $HOME/.ssh && cat /vagrant/id_rsa.pub >> $HOME/.ssh/authorized_keys
fi
SCRIPT

# generic/ubuntu1804 may hardcode global DNS servers (e.g. 4.2.2.1, 4.2.2.2,
# 208.67.220.220) in systemd-resolved, which may be unreachable from the host
# network. resolved sticks to the first one, so lookups fail. Clear them so only
# the DHCP-provided libvirt dnsmasq (which forwards to the host's resolvers) is used.
$dns_script = <<SCRIPT
# The box forces DNSSEC=yes, but answers relayed via libvirt dnsmasq cannot be
# validated ("DNSSEC validation failed: missing-key"), so disable validation.
mkdir -p /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNS=\nFallbackDNS=\nDNSSEC=no\n' > /etc/systemd/resolved.conf.d/99-libvirt-dns.conf
systemctl restart systemd-resolved
# The box's netplan config also pins the same servers on eth0. Remove them so the
# DHCP-supplied DNS (libvirt dnsmasq) is the only resolver, and apply immediately.
sed -i '/^ *nameservers:/,/^ *addresses:/d' /etc/netplan/*.yaml
netplan apply
sleep 5
SCRIPT

# 2 = version of configuration file for Vagrant 1.1+ leading up to 2.0.x
Vagrant.configure("2") do |config|

  # Suppress vagrant-vbguest which probes VBoxManage even under libvirt
  config.vbguest.auto_update = false if Vagrant.has_plugin?("vagrant-vbguest")

  config.vm.define :adoptopenjdkU18 do |adoptopenjdkU18|
    adoptopenjdkU18.vm.box = "generic/ubuntu1804"
    adoptopenjdkU18.vm.synced_folder ".", "/vagrant", type: "rsync"
    adoptopenjdkU18.vm.hostname = "adoptopenjdkU18"
    adoptopenjdkU18.vm.provision "shell", inline: $dns_script
    adoptopenjdkU18.vm.provision "shell", inline: $script, privileged: false
  end
  config.vm.provider "libvirt" do |v|
    v.memory = 2560
    v.cpus = 1
  end
end
